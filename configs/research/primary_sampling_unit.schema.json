{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "primary_train_en_v1_pool_proportional/sampling_unit",
  "title": "Prospective primary multimodal sampling unit; not a runnable train manifest",
  "type": "object",
  "required": ["unit_id", "source_id", "task_group", "source", "original_id", "kind", "turns", "image_hashes", "document_ids", "audit_status", "dedupe_key"],
  "properties": {
    "unit_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dedupe_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_id": {"enum": ["vqav2", "gqa", "llava_instruct", "textvqa", "docvqa", "infographic_vqa", "chartqa", "ai2d", "aokvqa", "scienceqa"]},
    "task_group": {"enum": ["general_vqa", "ocr_documents", "charts_diagrams", "knowledge_reasoning"]},
    "source": {
      "type": "object", "required": ["repo", "revision", "config", "split"],
      "properties": {"repo": {"type": "string"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "config": {"type": "string"}, "split": {"const": "train"}},
      "description": "Packaging train split alone does not prove original-source train status; source-ID/heldout audit is mandatory."
    },
    "original_id": {"type": "string"},
    "kind": {"enum": ["independent_qa", "genuine_dialogue"]},
    "turns": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["user", "assistant"], "additionalProperties": false,
        "properties": {"user": {"type": "string", "minLength": 1}, "assistant": {"type": "string", "minLength": 1}}}
    },
    "image_hashes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dialogue_key": {"type": ["string", "null"]},
    "partition": {"enum": ["train", "validation"]},
    "component_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "audit_status": {"type": "object", "additionalProperties": {"type": "boolean"}, "description": "Every preregistered audit must be true before sampling. Actual audit receipts and source/manifest binding remain future primary preparation work."}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "independent_qa"}}}, "then": {"properties": {"turns": {"maxItems": 1}}}},
    {"if": {"properties": {"source_id": {"enum": ["docvqa", "infographic_vqa"]}}}, "then": {"properties": {"document_ids": {"minItems": 1}}}}
  ]
}
